<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AgentSettingMapper">
    
    <resultMap type="AgentSetting" id="AgentSettingResult">
        <result property="settingId"    column="setting_id"    />
        <result property="userId"    column="user_id"    />
        <result property="agentType"    column="agent_type"    />
        <result property="province"    column="province"    />
        <result property="city"    column="city"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="userName"    column="user_name"    />
        <result property="nickName"    column="nick_name"    />
    </resultMap>

    <sql id="selectAgentSettingVo">
        select a.setting_id, a.user_id, a.agent_type, a.province, a.city, a.status, a.create_time,
               u.user_name, u.nick_name
        from agent_setting a
        left join sys_user u on a.user_id = u.user_id
    </sql>

    <select id="selectAgentSettingList" parameterType="AgentSetting" resultMap="AgentSettingResult">
        <include refid="selectAgentSettingVo"/>
        <where>  
            <if test="userId != null "> and a.user_id = #{userId}</if>
            <if test="agentType != null "> and a.agent_type = #{agentType}</if>
            <if test="province != null  and province != ''"> and a.province like concat('%', #{province}, '%')</if>
            <if test="city != null  and city != ''"> and a.city like concat('%', #{city}, '%')</if>
            <if test="status != null  and status != ''"> and a.status = #{status}</if>
        </where>
        order by a.create_time desc
    </select>
    
    <select id="selectAgentSettingBySettingId" parameterType="Long" resultMap="AgentSettingResult">
        <include refid="selectAgentSettingVo"/>
        where a.setting_id = #{settingId}
    </select>

    <select id="selectAgentsByProvinceAndCity" resultMap="AgentSettingResult">
        <include refid="selectAgentSettingVo"/>
        where a.status = '0'
        <if test="param1 != null and param1 != ''"> and a.province = #{param1}</if>
        <if test="param2 != null and param2 != ''"> and a.city = #{param2}</if>
        <if test="param2 == null or param2 == ''"> and (a.city is null or a.city = '')</if>
    </select>
        
    <insert id="insertAgentSetting" parameterType="AgentSetting" useGeneratedKeys="true" keyProperty="settingId">
        insert into agent_setting
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="agentType != null">agent_type,</if>
            <if test="province != null">province,</if>
            <if test="city != null">city,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="agentType != null">#{agentType},</if>
            <if test="province != null">#{province},</if>
            <if test="city != null">#{city},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateAgentSetting" parameterType="AgentSetting">
        update agent_setting
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="agentType != null">agent_type = #{agentType},</if>
            <if test="province != null">province = #{province},</if>
            <if test="city != null">city = #{city},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where setting_id = #{settingId}
    </update>

    <delete id="deleteAgentSettingBySettingId" parameterType="Long">
        delete from agent_setting where setting_id = #{settingId}
    </delete>

    <delete id="deleteAgentSettingBySettingIds" parameterType="String">
        delete from agent_setting where setting_id in 
        <foreach item="settingId" collection="array" open="(" separator="," close=")">
            #{settingId}
        </foreach>
    </delete>

    <delete id="deleteAgentSettingByUserId" parameterType="Long">
        delete from agent_setting where user_id = #{userId}
    </delete>

    <select id="selectAgentSettingByUserId" parameterType="Long" resultMap="AgentSettingResult">
        <include refid="selectAgentSettingVo"/>
        where a.user_id = #{userId} and a.status = '0'
        limit 1
    </select>

</mapper>
